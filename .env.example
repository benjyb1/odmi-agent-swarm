# Copy this to .env and fill in your keys
# NEVER commit .env — it's in .gitignore

# LLM — routed through CLIProxyAPI (localhost:8317) using Claude Max plan
# See: brew services start cliproxyapi
ANTHROPIC_API_KEY=odmi-local-proxy-key
ANTHROPIC_BASE_URL=http://localhost:8317

# Web search
TAVILY_API_KEY=tvly-...

# Translation (Phase B — not needed for Phase A)
DEEPL_API_KEY=

# Database is SQLite at data/odmi.db — no credentials needed
# Run: python scripts/setup_sqlite.py
