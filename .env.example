# Copy this to .env and fill in your keys.
# .env is in .gitignore. Keep it that way.
#
# None of these are needed to read results, replay an evaluation or run the
# dashboard. They are needed only to dispatch a new swarm run.

# LLM. Routed through CLIProxyAPI on localhost:8317 against the Claude Max
# plan, so there is no direct Anthropic billing (D1).
# Start the proxy with: brew services start cliproxyapi
ANTHROPIC_API_KEY=odmi-local-proxy-key
ANTHROPIC_BASE_URL=http://localhost:8317

# Web search. The pipeline is Serper for the SERP, trafilatura for extraction,
# and a Claude call to pick the snippet (agents/tools/search_diy.py).
SERPER_API_KEY=

# Retired search providers (D43). Their code paths survive so pre-D43 rows stay
# readable. Leave unset unless replaying a run from before the switch.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Translation fallback for low-resource languages.
DEEPL_API_KEY=

# Cross-family search adjudicator variants. One experiment arm only.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Dashboard behaviour. ODMI_READ_ONLY=1 disables every write button and is set
# on the public Streamlit deployment (D23).
ODMI_READ_ONLY=
ODMI_SKIP_AUTO_PUBLISH=

# The database is SQLite at data/odmi.db and needs no credentials.
# Build it with: uv run python scripts/setup_sqlite.py
