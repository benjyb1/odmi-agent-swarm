# Local environment and secrets
.env
.env.local

# Python build artefacts
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
dist/
*.egg-info/
.venv*
node_modules/

# OS junk
.DS_Store

# Claude Code local
.claude/settings.local.json
.claude/worktrees/
.context/

# Author's working material in the shared checkout. Drafts, reading and
# supervision decks that are not part of the submitted codebase. None of
# this has ever been tracked; the entries stop it being swept in by an
# absent-minded `git add -A`.
# Ignore the contents of Dissertation/, not the directory itself, so the
# LaTeX project below can be re-included. Git cannot re-include anything
# inside an excluded directory, which is why this is not "Dissertation/".
Dissertation/*
# The LaTeX project is the exception. Getting the dissertation into git is
# the point of the migration: plain text means two windows can work on it
# without the shasum-and-wait ritual the .docx needs.
!Dissertation/latex/
# Inside the LaTeX project: the PNGs pandoc extracted from the docx are
# a compile-time stopgap until the vector figures land, and the build
# outputs are regenerated on every compile. Neither belongs in git.
Dissertation/latex/media/
Dissertation/latex/main.pdf
Dissertation/latex/*.aux
Dissertation/latex/chapters/*.aux
Dissertation/latex/*.log
Dissertation/latex/*.toc
Dissertation/latex/*.lof
Dissertation/latex/*.lot
Dissertation/latex/*.out
Dissertation/latex/*.bbl
Dissertation/latex/*.bcf
Dissertation/latex/*.blg
Dissertation/latex/*.run.xml
MSC CLAUDE NOTES/
Presentations/
Research/
ODMI_Technical_Walkthrough.docx
*.zip

# WHO Europe speech-writer. A separate side project that reuses the swarm
# against the IRIS EURO document set. Nothing in this repository imports it,
# and it is not part of the dissertation, so it is kept out of what an
# examiner clones. The directory stays on disk and its history stays in the
# commits up to and including 2abe462.
who_speech/

# SQLite write-ahead and shared-memory files (the .db itself is committed)
*.db-wal
*.db-shm
*.db-journal

# Rendered PDFs of the report (regenerate from REPORT_PRELIM.md)
docs/*.pdf

# Office lock files
~$*

# Notes scratch directory (not for committing drafts of anything important)
notes/

# Brainstorm visual-companion working files
.superpowers/

# Dashboard runtime artefacts (per-batch dispatcher logs, test screenshots,
# test reports). Run-specific; do not commit.
dashboard/logs/
dashboard/tests/screenshots/
dashboard/tests/test_user_paths_report.json

# Pre-decision DB snapshots. Local audit trail; SPEC.md records where they sit.
data/odmi.db.bak-*

# Snippet-quality fixture (regenerated from the DB on demand; not committed).
tests/fixtures/snippet_quality.jsonl

# Eyeball harness output (generated HTML; not committed).
evaluation/snippets_eyeball.html

# DIY-vs-Tavily eval evidence cache (transient; the durable per-pair records
# with embedded evidence + verdicts live in evaluation/results/, committed).
# Lets a re-run skip Serper / Tavily / fetch calls.
evaluation/.cache_diy_vs_tavily.json

# Adjudication verdict cache (transient; the durable verdicts live in the
# committed evaluation/results/ JSONL). Lets a crashed Opus judge run resume
# without re-paying for already-judged orientations.
evaluation/.cache_adjudications.json

# D30 catalogue-metrics raw harvest cache. FR is ~74k datasets, DE ~151k:
# far too large for git. The committed reproducibility receipt is the
# catalogue_snapshots / catalogue_metrics rows + each snapshot's manifest.
# Re-harvest from the manifest endpoint to reproduce.
data/catalogue_snapshots/

# Transient run logs (results JSONL are kept; logs are not)
evaluation/results/*.log
evaluation/runs/

# Migration backups (timestamped DB copies)
data/odmi.*.pre-*.db

# Generated QA output
build/
